# Server-only credentials. Copy this file to .env and add your real values.
TAVUS_API_KEY=tvsk_your_api_key_here
# PAL with a default Face. Add TAVUS_FACE_ID only when the PAL has no default face.
TAVUS_PAL_ID=your_pal_id_here
TAVUS_FACE_ID=
# Comma-separated browser origins allowed to call the local API.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
