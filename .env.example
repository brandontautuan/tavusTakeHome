# Server-only Tavus credentials. Copy to .env; never commit the real values.
TAVUS_API_KEY=tvsk_your_api_key_here
# A PAL configured in Tavus PAL Maker with a default face. If it has no default face,
# also set TAVUS_FACE_ID.
TAVUS_PAL_ID=your_pal_id_here
TAVUS_FACE_ID=
# Optional: comma-separated local origins allowed to call the local API.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
